yaml
name: build

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.5

      - name: Compilar
        run: gradle build

      - uses: actions/upload-artifact@v4
        with:
          name: chaosblades-mod
          path: |
            build/libs/*.jar
            !build/libs/*-sources.jar
